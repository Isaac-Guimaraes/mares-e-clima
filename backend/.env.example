# Copie este arquivo para .env e ajuste se necessário.

# Porta HTTP da API
PORT=3333

# Origem permitida pelo CORS (endereço do front-end). Vazio: aceita qualquer origem.
CORS_ORIGIN=

# Tempo de vida do cache das respostas do Open-Meteo, em minutos (RNF01: mínimo 60)
CACHE_TTL_MINUTOS=60

# País padrão da busca de praias (ISO 3166-1 alfa-2). Deixe vazio para buscar no mundo todo.
PAIS_PADRAO=BR
