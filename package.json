{
  "name": "mares-e-clima",
  "version": "0.1.0",
  "private": true,
  "description": "Previsão de marés e do tempo para praias, com APIs públicas do Open-Meteo.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "test": "npm test --workspace=backend",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
